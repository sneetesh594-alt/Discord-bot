# Copy to .env locally. Never paste your real tokens into a chat or commit them.
DISCORD_BOT_TOKEN=replace_with_your_discord_bot_token
# Optional: use one test server for fast command registration; blank = global.
DEV_GUILD_ID=
# Set true once after command changes; set false after successful registration.
SYNC_COMMANDS=true
CONFIG_PATH=config.yaml
DATABASE_PATH=data/aegis.sqlite3
LOG_LEVEL=INFO
LOG_FILE=logs/aegis.log
# Optional initial private moderation channel for new guild settings.
MOD_LOG_CHANNEL_ID=
# Both this switch and /config ai enabled:true must be set to use external AI.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
# Optional dashboard: Start-Alpha.cmd enables the local server.
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
DASHBOARD_PUBLIC_URL=http://127.0.0.1:8765
# Client ID defaults to the connected bot application ID. This is not the bot token.
DISCORD_CLIENT_ID=
# Keep this value local; OAuth2 redirect must match /auth/callback above.
DISCORD_CLIENT_SECRET=
